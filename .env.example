# Copy to .env and adjust. All values are optional — defaults work for local runs.

# SQLite database file
DB_PATH=./data/leads.sqlite

# CSV deliverable
OUTPUT_CSV=./output/leads-sao-paulo.csv

# Run the browser with a visible window (useful for debugging selectors)
HEADFUL=0

# Optional HTTP/HTTPS proxy for the Playwright browser, e.g. http://user:pass@host:port
# Leave empty to use your own IP.
PROXY_URL=

# Politeness knobs (seconds)
SEARCH_MIN_DELAY=8
SEARCH_MAX_DELAY=20
DETAIL_MIN_DELAY=3
DETAIL_MAX_DELAY=8

# Concurrency for the non-browser enrichment phase
ENRICH_CONCURRENCY=4
