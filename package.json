{
  "name": "lp-crm-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Google Maps lead scraper for São Paulo — finds barbershops, gyms, salons and tattoo studios with no website or a broken one, and enriches them with a verified Instagram profile and a WhatsApp link. Output: a local CSV.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "tsx src/index.ts scrape",
    "search": "tsx src/index.ts search",
    "detail": "tsx src/index.ts detail",
    "enrich": "tsx src/index.ts enrich",
    "export": "tsx src/index.ts export",
    "stats": "tsx src/index.ts stats",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "csv-stringify": "^6.5.2",
    "fastest-levenshtein": "^1.0.16",
    "libphonenumber-js": "^1.11.20",
    "p-limit": "^6.2.0",
    "playwright": "^1.50.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
